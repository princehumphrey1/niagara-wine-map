<html lang="en">\
<head>\
<meta charset="UTF-8">\
<meta name="viewport" content="width=device-width, initial-scale=1.0">\
<title>Niagara Wine Region \'97 Interactive Map</title>\
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>\
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>\
<style>\
  :root\{\
    --artifact-bg: var(--theme-background, #f7f2ea);\
    --artifact-panel: var(--theme-background-light, #fffaf3);\
    --artifact-ink: var(--theme-text-primary, #2a1a1f);\
    --artifact-muted: var(--theme-text-secondary, #6d5a52);\
    --artifact-wine: #7a1f3d;\
    --artifact-wine-deep: #591026;\
    --artifact-gold: #b3862f;\
    --artifact-line: rgba(90,16,38,0.16);\
    --artifact-bench: #7a1f3d;\
    --artifact-shore: #2f6f6b;\
    --artifact-shadow: 0 6px 22px rgba(60,20,30,0.14);\
  \}\
  html[data-theme='dark']\{\
    --artifact-bg:#171012; --artifact-panel:#211619; --artifact-ink:#f3e7e0;\
    --artifact-muted:#c3a99f; --artifact-line:rgba(255,220,210,0.14);\
    --artifact-wine:#c8496c; --artifact-gold:#d7a94b; --artifact-shore:#4bb0a8;\
    --artifact-bench:#c8496c; --artifact-shadow:0 6px 22px rgba(0,0,0,0.5);\
  \}\
  *\{box-sizing:border-box\}\
  html,body\{height:100%\}\
  body\{\
    margin:0; font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;\
    background:var(--artifact-bg); color:var(--artifact-ink);\
    display:flex; flex-direction:column; height:100vh; overflow:hidden;\
  \}\
  header.topbar\{\
    display:flex; align-items:baseline; gap:14px; flex-wrap:wrap;\
    padding:14px 22px; border-bottom:1px solid var(--artifact-line);\
    background:var(--artifact-panel);\
  \}\
  header.topbar h1\{\
    margin:0; font-size:1.5rem; letter-spacing:.3px; color:var(--artifact-wine);\
    font-weight:600;\
  \}\
  header.topbar .sub\{ font-family:ui-monospace,"SF Mono",Menlo,monospace;\
    font-size:.72rem; letter-spacing:.14em; text-transform:uppercase; color:var(--artifact-muted); \}\
  .shell\{ display:flex; flex:1; min-height:0; \}\
  aside\{\
    width:340px; flex-shrink:0; background:var(--artifact-panel);\
    border-right:1px solid var(--artifact-line); overflow-y:auto; padding:18px 18px 40px;\
  \}\
  #map\{ flex:1; min-width:0; \}\
  .leaflet-container\{ background:#dfe7ea; font-family:inherit; \}\
  .block\{ margin-bottom:22px; \}\
  .block h2\{\
    font-size:.74rem; letter-spacing:.16em; text-transform:uppercase;\
    color:var(--artifact-gold); margin:0 0 10px; font-family:ui-monospace,Menlo,monospace;\
    font-weight:700;\
  \}\
  .intro\{ font-size:.92rem; line-height:1.55; color:var(--artifact-muted); margin:0 0 6px; \}\
  .toggle-row\{ display:flex; align-items:center; gap:10px; padding:6px 4px; cursor:pointer; border-radius:8px; \}\
  .toggle-row:hover\{ background:var(--artifact-bg); \}\
  .toggle-row input\{ accent-color:var(--artifact-wine); width:16px; height:16px; cursor:pointer; \}\
  .toggle-row label\{ cursor:pointer; font-size:.9rem; flex:1; \}\
  .swatch\{ width:14px; height:14px; border-radius:3px; flex-shrink:0; \}\
  .base-opts label\{ display:block; padding:6px 4px; border-radius:8px; cursor:pointer; font-size:.9rem; \}\
  .base-opts label:hover\{ background:var(--artifact-bg); \}\
  .base-opts input\{ accent-color:var(--artifact-wine); margin-right:8px; \}\
